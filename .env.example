APP_NAME="GEARORA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Target produksi (AeonFree): MySQL 8.0.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gearora
DB_USERNAME=gearora
DB_PASSWORD=

# Alternatif development tanpa MySQL (uncomment untuk memakai SQLite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ------------------------------------------------------------------
# Session / Cache / Queue
# ------------------------------------------------------------------
# Redis TIDAK diasumsikan tersedia di AeonFree. Memakai driver database/file.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue worker persisten tidak tersedia di shared hosting -> default sync.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Mail — nilai placeholder, GANTI di produksi bila fitur email dipakai.
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@gearora.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ------------------------------------------------------------------
# Midtrans (payment gateway) — SANDBOX by default.
# JANGAN commit kredensial asli. Server Key tidak pernah dikirim ke browser.
# Isi nilai asli hanya di .env lokal/produksi, bukan di file ini.
# ------------------------------------------------------------------
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_SANDBOX_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_PRODUCTION_BASE_URL=https://api.midtrans.com
MIDTRANS_SNAP_SANDBOX_URL=https://app.sandbox.midtrans.com/snap/v2/vtweb
MIDTRANS_SNAP_PRODUCTION_URL=https://app.midtrans.com/snap/v2/vtweb
MIDTRANS_EXPIRY_MINUTES=60
MIDTRANS_NOTIFICATION_URL=
MIDTRANS_HTTP_TIMEOUT=20

# Gateway otomatis hanya aktif bila kredensial valid tersedia.
GEARORA_PAYMENT_GATEWAY_ENABLED=false
